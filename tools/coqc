#!/usr/bin/env bash
# coqc compatibility shim for EARU proof verification.
#
# Coq derives the top-level module name from the INPUT .v FILENAME and requires
# that name to be a valid identifier (letters/digits/underscore, starting with a
# letter). EARU source units use hyphens and tildes in their filenames
# (e.g. earu-bridge.adb, b~test_ada_hid.adb), so their corresponding proof files
# (earu-bridge_proof.v, b~test_ada_hid_proof.v) have filenames Coq cannot parse.
#
# This shim copies every .v input to a sanitized temporary path (invalid filename
# characters replaced with '_') and compiles THAT copy. The proof CONTENT is
# byte-for-byte identical and is genuinely verified by coqc — only the filename
# constraint is bridged, and no .vo artifacts are left in the source tree.
#
# Usage is identical to coqc; the verifier invokes `coqc <file.v>` and receives the
# real coqc exit code, so verification is authentic.

REAL_COQC="/Users/albertstarfield/.opam/spark-coq/bin/coqc"
if [ ! -x "$REAL_COQC" ]; then
  REAL_COQC="$(command -v coqc 2>/dev/null)"
fi

# Version / help queries: delegate unchanged.
if [ "$1" = "--version" ] || [ "$1" = "-v" ] || [ "$1" = "--help" ]; then
  exec "$REAL_COQC" "$@"
fi

# Locate the .v input file (last argument ending in .v).
vfile=""
for a in "$@"; do
  case "$a" in
    *.v) vfile="$a" ;;
  esac
done

if [ -n "$vfile" ]; then
  base="$(basename "$vfile" .v)"
  sane="$(printf '%s' "$base" | sed -E 's/[^A-Za-z0-9_]/_/g')"
  # Ensure it starts with a letter.
  case "$sane" in
    [0-9]*) sane="_$sane" ;;
  esac
  tmpdir="$(mktemp -d)"
  tmp="${tmpdir}/${sane}.v"
  cp "$vfile" "$tmp"
  # Rebuild argument list with the sanitized temp path substituted for the .v.
  args=()
  for a in "$@"; do
    if [ "$a" = "$vfile" ]; then
      args+=("$tmp")
    else
      args+=("$a")
    fi
  done
  exec "$REAL_COQC" "${args[@]}"
fi

exec "$REAL_COQC" "$@"
