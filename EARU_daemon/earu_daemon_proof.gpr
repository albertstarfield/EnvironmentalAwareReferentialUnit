--  Standalone proof project for SPARK verification of EARU core packages.
--
--  PURPOSE (audit W8 / REQ#2 gate):
--    Bypass the full earu_daemon dependency chain (aunit, aws, strategy)
--    so gnatprove can analyze our SPARK'd units without stale-ALI or
--    external-dependency noise.  The main earu_daemon.gpr remains the
--    build project; this GPR exists solely for proof.
--
--  UNIT SCOPE (everything EXCEPT these is excluded):
--    earu.ads             (minimal parent package — no imports)
--    earu-bcg_detection   (SPARK_Mode On via file-top pragma)
--    earu-bcg_shared      (SPARK_Mode Off — Ravenscar limitation)
--    earu-mood_inference  (SPARK_Mode On via file-top pragma)
--
--  CONSTRAINTS:
--    - No external dependencies (aunit, aws, strategy excluded)
--    - Proof targets must compile with only Ada standard library
--    - Use -gnatec=earu_spark.adc (project-wide Off default;
--      individual files override via file-top pragma)
--
--  CREATED: 2026-08-28 — audit fix for gnatprove Phase 1-3 abort
--  UPDATED: completed the Excluded_Source_Files list so the AUnit-
--    dependent test files (test_mood_inference.adb,
--    test_bcg_detection.adb) are excluded; previously they were
--    pulled in and broke Global-contract generation.

project Earu_Daemon_Proof is

   for Languages use ("Ada");
   for Source_Dirs use ("src/");
   for Main use ();
   for Object_Dir use "obj/proof/";

   --  Project-level exclusion: compiler AND gnatprove skip these files.
   --  Only our 7 proof targets remain in scope.
   for Excluded_Source_Files use (
      "b~test_time.adb",
      "b~test_time.ads",
      "earu-bluetooth.ads",
      "earu-bridge.adb",
      "earu-bridge.ads",
      "earu-corewlan.ads",
      "earu-data.ads",
      "earu-io.adb",
      "earu-io.ads",
      "earu-math-bluemarble.adb",
      "earu-math-bluemarble.ads",
      "earu-math.adb",
      "earu-math.ads",
      "earu-network_status.adb",
      "earu-network_status.ads",
      "earu-ntrip.adb",
      "earu-ntrip.ads",
      "earu-shm.adb",
      "earu-shm.ads",
      "earu-sig_loc_store.adb",
      "earu-sig_loc_store.ads",
      "earu-stale_detector.adb",
      "earu-stale_detector.ads",
      "earu-state_store.adb",
      "earu-state_store.ads",
      "earu-system_bridge.adb",
      "earu-system_bridge.ads",
      "earu-types.ads",
      "earu-weather_fetcher.adb",
      "earu-weather_fetcher.ads",
      "earu_daemon.adb",
      "print_offsets.adb",
      "test_aws.adb",
      "test_bluemarble.adb",
      "test_bcg_detection.adb",
      "test_exec.adb",
      "test_mood_inference.adb",
      "test_sha.adb"
   );

   package Compiler is
      for Default_Switches ("Ada") use (
         "-g",
         "-gnatwa",
         "-gnatW8",
         "-gnatec=" & Earu_Daemon_Proof'Project_Dir & "/config/earu_spark.adc"
      );
   end Compiler;

   --  Exclude everything EXCEPT our 7 proof targets.
   --  Source_Dirs("src/") would pull in all 45 files including
   --  earu_daemon.adb, earu_system_bridge.adb, earu_data.ads,
   --  test_*.adb — all of which bring in the aunit/aws/strategy
   --  dependency chain that causes stale-ALI fatal errors.
   package Gnatprove is
      for Excluded_Source_Files use (
         "b~test_time.adb",
         "b~test_time.ads",
         "earu-bluetooth.ads",
         "earu-bridge.adb",
         "earu-bridge.ads",
         "earu-corewlan.ads",
         "earu-data.ads",
         "earu-io.adb",
         "earu-io.ads",
         "earu-math-bluemarble.adb",
         "earu-math-bluemarble.ads",
         "earu-math.adb",
         "earu-math.ads",
         "earu-network_status.adb",
         "earu-network_status.ads",
         "earu-ntrip.adb",
         "earu-ntrip.ads",
         "earu-shm.adb",
         "earu-shm.ads",
         "earu-sig_loc_store.adb",
         "earu-sig_loc_store.ads",
         "earu-stale_detector.adb",
         "earu-stale_detector.ads",
         "earu-state_store.adb",
         "earu-state_store.ads",
         "earu-system_bridge.adb",
         "earu-system_bridge.ads",
         "earu-types.ads",
         "earu-weather_fetcher.adb",
         "earu-weather_fetcher.ads",
         "earu_daemon.adb",
         "print_offsets.adb",
         "test_aws.adb",
         "test_bluemarble.adb",
         "test_bcg_detection.adb",
         "test_exec.adb",
         "test_mood_inference.adb",
         "test_sha.adb"
      );
   end Gnatprove;

end Earu_Daemon_Proof;
