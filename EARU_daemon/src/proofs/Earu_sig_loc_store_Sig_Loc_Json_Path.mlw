module Earu_sig_loc_store_Sig_Loc_Json_Path

  use int.Int



  let sig_Loc_Json_Path () : int
    requires { true — Project_Root constant, join cannot fail. }
    ensures { true — non-empty path mem ending significant_locations.json. }
    = Earu.IO.Project_Root & "/save_state/significant_locations.json"

end