module Earu_ntrip_LLA_To_ECEF

  use int.Int



  let lLA_To_ECEF (lat: int) (lon: int) (alt: int) (x: int) (y: int) (z: int) : int
    requires { lat >= 0 }
    requires { lon >= 0 }
    requires { alt >= 0 }
    requires { x >= 0 }
    requires { y >= 0 }
    requires { z >= 0 }
    ensures { result >= 0 }
    = lat

end