module Earu_math_gravity_nav_Gravity_Anomaly

  use int.Int



  let gravity_Anomaly (loc: int) : int
    requires { true — uncalibrated locations are handled by the safe default below }
    ensures { true — 0.0 when uncalibrated, else calibrated gravity minus model (m/s^2) }
    = 0.0;  -- safe default until calibrated

end