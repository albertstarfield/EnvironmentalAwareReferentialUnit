with "config/earu_daemon_config.gpr";
project Earu_Daemon is

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Earu_Daemon_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("earu_daemon.adb", "print_offsets.adb");

   for Archive_Builder use ("/usr/bin/ar", "cr");
   for Archive_Indexer use ("/usr/bin/ranlib");

   package Compiler is
      for Driver ("C") use "/usr/bin/clang";
      --  -gnatec= loads config/earu_spark.adc (audit W8 fix): project-wide
      --  SPARK_Mode (Off) default; proven packages opt back in via explicit
      --  `with SPARK_Mode => On` aspects. Keeps gnatprove from aborting on
      --  legacy non-SPARK units while still checking the new real-time core.
      for Default_Switches ("Ada") use ("-g", "-O2", "-gnatwa", "-gnatW8",
         "-gnatec=" & Earu_Daemon'Project_Dir & "/config/earu_spark.adc");
      for Default_Switches ("C") use ("-g", "-O2", "-isysroot", "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk");
   end Compiler;

   package Linker is
      --  AXIOM: corewlan_scanner.o is compiled separately by start.sh
      --  (clang++ -ObjC++ — Alire cannot compile .mm files).
      --  We link it here along with CoreWLAN and Foundation frameworks.
       for Switches ("Ada") use (
          "-L/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/lib",
          "-F/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/System/Library/Frameworks",
          "-framework", "IOKit",
          "-framework", "CoreFoundation",
          "-framework", "CoreWLAN",
          "-framework", "CoreBluetooth",
          "-framework", "Foundation",
          "-lstdc++",
          "obj/release/corewlan_scanner.o",
          "obj/release/bluetooth_scanner.o"
       );
   end Linker;

   package Gnatprove is
      --  Exclude external-library sources that are not SPARK-compatible.
      --  aws-net.ads uses controlled types (Socket_Type'Class) which SPARK
      --  forbids; s-taskin.ads uses access-to-protected-subprogram types.
      --  These are pre-existing AWS/Ada-runtime limitations, not EARU code.
      --
      --  Exclude pre-existing test mains that have compilation errors from
      --  missing types (earu-data.ads dependencies) and produce stale .ali
      --  files incompatible with gnatprove's gnatbind.
      for Excluded_Source_Files use (
         "aws-net.ads", "s-taskin.ads",
         "test_bluemarble.adb", "test_exec.adb",
         "test_sha.adb", "test_aws.adb");
   end Gnatprove;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Earu_Daemon;
